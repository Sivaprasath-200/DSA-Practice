class Solution {
    public int maxIncreaseKeepingSkyline(int[][] grid) {

        int n = grid.length;

        int[] rowMax = new int[n];
        int[] colMax = new int[n];

        // Find maximum of each row
        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {
                rowMax[i] = Math.max(rowMax[i], grid[i][j]);
            }
        }

        // Find maximum of each column
        for (int j = 0; j < n; j++) {

            for (int i = 0; i < n; i++) {
                colMax[j] = Math.max(colMax[j], grid[i][j]);
            }
        }

        int total = 0;

        // Calculate maximum possible increase
        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                int newHeight = Math.min(rowMax[i], colMax[j]);

                total += newHeight - grid[i][j];
            }
        }

        return total;
    }
}
